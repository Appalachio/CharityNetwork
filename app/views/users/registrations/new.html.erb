<div class="md:w-2/3 w-full">
  <h2 class="font-bold text-2xl">New Account</h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render "users/shared/error_messages", resource: resource %>

    <div class="my-5">
      <%= f.label :email, class: "fieldset-legend" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: [ "cn-form-input", { "cn-form-input-no-errors": resource.errors[:email].none?, "cn-form-input-errors": resource.errors[:email].any? } ] %>
    </div>

    <div class="my-5">
      <%= f.label :password, class: "fieldset-legend" %>
      <% if @minimum_password_length %>
        <p class="label"><em>(<%= @minimum_password_length %> characters minimum)</em></p>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password", class: [ "cn-form-input", { "cn-form-input-no-errors": resource.errors[:password].none?, "cn-form-input-errors": resource.errors[:password].any? } ] %>
    </div>

    <div class="my-5">
      <%= f.label :password_confirmation, class: "fieldset-legend" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: [ "cn-form-input", { "cn-form-input-no-errors": resource.errors[:password_confirmation].none?, "cn-form-input-errors": resource.errors[:password_confirmation].any? } ] %>
    </div>

    <div class="my-5">
      <%= f.label :username, class: "fieldset-legend" %>
      <%= f.textarea :username, rows: 1, class: [ "cn-form-input", { "cn-form-input-no-errors": resource.errors[:username].none?, "cn-form-input-errors": resource.errors[:username].any? } ] %>
    </div>

    <div class="my-5">
      <%= f.label :display_name, class: "fieldset-legend" %>
      <%= f.textarea :display_name, rows: 1, class: [ "cn-form-input", { "cn-form-input-no-errors": resource.errors[:display_name].none?, "cn-form-input-errors": resource.errors[:display_name].any? } ] %>
    </div>

    <div class="my-5">
      <%= f.label :profile_picture, "Profile picture (optional)", class: "fieldset-legend" %>
      <%= f.file_field :profile_picture, class: [ "block shadow-sm file-input w-full", { "cn-form-input-no-errors": resource.errors[:profile_picture].none?, "cn-form-input-errors": resource.errors[:profile_picture].any? } ] %>
    </div>

    <div class="inline">
      <%= f.submit "Create", class: "btn btn-primary" %>
      <%= link_to "Back", :back, class: "btn btn-neutral" %>
    </div>
  <% end %>

  <%= render "users/shared/links" %>
</div>
