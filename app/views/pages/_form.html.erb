<%= form_with(model: page, class: "contents") do |form| %>
  <% if page.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(page.errors.count, "error") %> prohibited this page from being saved:</h2>

      <ul class="list-disc ml-6">
        <% page.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :title, class: "fieldset-legend" %>
    <%= form.textarea :title, rows: 1, class: [ "cn-form-input", { "cn-form-input-no-errors": page.errors[:title].none?, "cn-form-input-no-errors": page.errors[:title].any? } ] %>
  </div>

  <div class="my-5">
    <%= form.label :subtitle, "Subtitle (optional)", class: "fieldset-legend" %>
    <%= form.textarea :subtitle, rows: 1, class: [ "cn-form-input", { "cn-form-input-no-errors": page.errors[:subtitle].none?, "cn-form-input-errors": page.errors[:subtitle].any? } ] %>
  </div>

  <div class="my-5">
    <%= form.label :body, class: "fieldset-legend" %>
    <%= form.rich_textarea :body, class: [ "cn-form-input", { "cn-form-input-no-errors": page.errors[:body].none?, "cn-form-input-errors": page.errors[:body].any? } ] %>
  </div>

  <div class="my-5">
    <%= form.label :page_attachments, "Page attachments (optional)", class: "fieldset-legend" %>
    <%= form.file_field :page_attachments, multiple: true, class: [ "block shadow-sm file-input w-full", { "cn-form-input-no-errors": page.errors[:page_attachments].none?, "cn-form-input-errors": page.errors[:page_attachments].any? } ] %>
  </div>

  <div class="my-5">
    <%= form.label :published_at, class: "fieldset-legend" %>
    <p class="label">The date and time (in UTC timezone) that this page will be visible to everyone.<p>
    <p class="label">Leave blank to keep this page private indefinitely.</p>
    <p class="label">Set to a date and time in the past to make this page public now.</p>
    <%= form.datetime_field :published_at, class: [ "cn-form-input", { "cn-form-input-no-errors": page.errors[:published_at].none?, "cn-form-input-errors": page.errors[:published_at].any? } ] %>
  </div>

  <div class="inline">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
