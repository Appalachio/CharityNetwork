<% content_for :title, "Pages" %>

<div class="w-full">
  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Pages</h1>
    <%= link_to "New page", new_page_path, class: "btn btn-primary" %>
  </div>

  <div id="pages" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @pages.any? %>
      <% @pages.each do |page| %>
        <div class="flex flex-col sm:flex-row justify-between items-center pb-5 sm:pb-0">
          <%= render page %>
          <div class="w-full sm:w-auto flex flex-col sm:flex-row space-x-2 space-y-2">
            <%= link_to "Show", page, class: "btn btn-primary" %>
            <% if allowed_to?(:edit?, page) %>
              <%= link_to "Edit", edit_page_path(page), class: "btn btn-secondary" %>
            <% end %>
            <% if allowed_to?(:archive?, page) && page.active? %>
              <%= link_to "Archive", archive_page_path(page), class: "btn btn-warning", data: { turbo_confirm: "Are you sure you want to archive this page?" } %>
            <% end %>
            <% if allowed_to?(:restore, page) && page.archived? %>
              <%= link_to "Restore", restore_page_path(page), class: "btn btn-outline btn-warning", data: { turbo_confirm: "Are you sure you want to restore this pgae?" } %>
            <% end %>
            <% if allowed_to?(:destroy?, page) %>
              <%= button_to "Destroy", page, method: :delete, class: "btn btn-error", data: { turbo_confirm: "Are you sure you want to delete this page? This cannot be undone." } %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">No pages found.</p>
    <% end %>
  </div>
</div>
